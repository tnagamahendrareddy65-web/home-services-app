datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Service {
  id          String    @id @default(uuid())
  title       String
  description String
  price       Float
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Booking {
  id        String   @id @default(uuid())
  name      String
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  date      DateTime
  createdAt DateTime @default(now())
}