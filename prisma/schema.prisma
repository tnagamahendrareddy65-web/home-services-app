datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  services    Service[]
}

model Service {
  id          String    @id @default(uuid())
  title       String
  price       Float
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

model Booking {
  id        String   @id @default(uuid())
  name      String
  email     String
  userId    String?  // Optional or required depending on your setup
  user      User?    @relation(fields: [userId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  date      DateTime
  createdAt DateTime @default(now())
}